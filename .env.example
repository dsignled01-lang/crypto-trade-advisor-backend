# Copy environment variables to .env
# Exchange API Keys - Binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Exchange API Keys - OKX
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase

# Exchange API Keys - KuCoin
KUCOIN_API_KEY=your_kucoin_api_key
KUCOIN_API_SECRET=your_kucoin_api_secret
KUCOIN_PASSPHRASE=your_kucoin_passphrase

# Exchange API Keys - Coinbase
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

# Exchange API Keys - Gate.io
GATE_IO_API_KEY=your_gate_io_api_key
GATE_IO_API_SECRET=your_gate_io_api_secret

# Exchange API Keys - ByBit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Cache Configuration (in seconds)
CACHE_TTL=300

# Signal Configuration
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

BB_PERIOD=20
BB_STD_DEV=2

ATR_PERIOD=14
ATR_MULTIPLIER=2.0

# Connection Configuration
CONNECTION_TIMEOUT=10
RETRY_ATTEMPTS=3
RETRY_DELAY=2
